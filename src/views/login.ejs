<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Login</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css"
        rel="stylesheet"
    >

</head>

<body class="min-h-screen bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 flex items-center justify-center p-6">

    <!-- Background -->

    <div class="absolute inset-0 overflow-hidden">

        <div class="absolute -top-32 -left-32 w-96 h-96 bg-indigo-500/20 rounded-full blur-3xl"></div>

        <div class="absolute bottom-0 right-0 w-[450px] h-[450px] bg-purple-600/20 rounded-full blur-3xl"></div>

    </div>

    <!-- Card -->

    <div class="relative w-full max-w-md">

        <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-3xl shadow-2xl p-8">

            <!-- Logo -->

            <div class="flex justify-center">

                <div class="w-20 h-20 rounded-full bg-gradient-to-r from-indigo-600 to-purple-600 flex items-center justify-center">

                    <i class="ri-shield-user-fill text-4xl text-white"></i>

                </div>

            </div>

            <h1 class="text-3xl font-bold text-center text-white mt-6">

                Admin Login

            </h1>

            <p class="text-center text-gray-300 mt-2">

                Color Prediction Admin Panel

            </p>

            <!-- Error -->

            <% if(typeof error !== 'undefined'){ %>

            <div class="mt-6 bg-red-500/20 border border-red-500 text-red-200 rounded-xl p-3">

                <%= error %>

            </div>

            <% } %>

            <!-- Form -->

            <form
                action="/admin/login"
                method="POST"
                class="mt-8 space-y-5"
            >

                <!-- Username -->

                <div>

                    <label class="text-gray-200 text-sm">

                        Username

                    </label>

                    <div class="mt-2 flex items-center bg-white/10 rounded-xl px-4 border border-white/20">

                        <i class="ri-user-3-line text-gray-300"></i>

                        <input
                            type="text"
                            name="mobile"
                            required
                            class="w-full p-4 bg-transparent outline-none text-white placeholder-gray-400"
                            placeholder="Enter Mobile Number"
                        >

                    </div>

                </div>

                <!-- Password -->

                <div>

                    <label class="text-gray-200 text-sm">

                        Password

                    </label>

                    <div class="mt-2 relative">

                        <div class="flex items-center bg-white/10 rounded-xl px-4 border border-white/20">

                            <i class="ri-lock-2-line text-gray-300"></i>

                            <input
                                id="password"
                                type="password"
                                name="password"
                                required
                                class="w-full p-4 bg-transparent outline-none text-white placeholder-gray-400"
                                placeholder="Enter Password"
                            >

                            <button
                                type="button"
                                onclick="togglePassword()"
                            >

                                <i
                                    id="eye"
                                    class="ri-eye-line text-gray-300 text-lg"
                                ></i>

                            </button>

                        </div>

                    </div>

                </div>

                <!-- Remember -->

                <div class="flex justify-between items-center">

                    <label class="flex items-center gap-2 text-gray-300">

                        <input
                            type="checkbox"
                            class="rounded"
                        >

                        Remember Me

                    </label>

                    <a
                        href="#"
                        class="text-indigo-300 hover:text-white"
                    >

                        Forgot Password?

                    </a>

                </div>

                <!-- Button -->

                <button
                    class="w-full bg-gradient-to-r from-indigo-600 to-purple-600 text-white py-4 rounded-xl font-semibold hover:scale-105 transition"
                >

                    Login

                </button>

            </form>

            <div class="text-center mt-8 text-gray-400 text-sm">

                © 2026 Color Prediction Admin

            </div>

        </div>

    </div>

    <script>

        function togglePassword(){

            const password=document.getElementById("password");

            const eye=document.getElementById("eye");

            if(password.type==="password"){

                password.type="text";

                eye.className="ri-eye-off-line text-gray-300 text-lg";

            }else{

                password.type="password";

                eye.className="ri-eye-line text-gray-300 text-lg";

            }

        }

    </script>

</body>

</html>