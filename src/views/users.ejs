<div class="bg-white rounded-2xl shadow-lg p-6">

    <div class="flex justify-between items-center mb-6">

        <h2 class="text-2xl font-bold">
            Users
        </h2>

        <form method="GET" action="/admin/users" class="flex gap-2">

            <input
                type="text"
                name="search"
                value="<%= search %>"
                placeholder="Search Name / Mobile"
                class="border rounded-lg px-4 py-2 outline-none focus:ring-2 focus:ring-indigo-500"
            >

            <button class="bg-indigo-600 text-white px-5 rounded-lg">
                Search
            </button>

        </form>

    </div>

    <div class="overflow-x-auto">

        <table class="min-w-full text-sm">

            <thead class="bg-gray-100">

                <tr>

                    <th class="px-4 py-3 text-left">Name</th>

                    <th class="px-4 py-3 text-left">Mobile</th>

                    <th class="px-4 py-3 text-center">Wallet</th>

                    <th class="px-4 py-3 text-center">Transactions</th>

                    <th class="px-4 py-3 text-center">Total Bets</th>

                    <th class="px-4 py-3 text-center">Bet Amount</th>

                    <th class="px-4 py-3 text-center">Win</th>

                    <th class="px-4 py-3 text-center">Loss</th>

                    <th class="px-4 py-3 text-center">Status</th>

                    <th class="px-4 py-3 text-center">Joined</th>

                </tr>

            </thead>

            <tbody>

                <% users.forEach(user=>{ %>

                <tr class="border-b hover:bg-gray-50">

                    <td class="px-4 py-3 font-semibold">
                        <%= user.name %>
                    </td>

                    <td class="px-4 py-3">
                        <%= user.mobile %>
                    </td>

                    <td class="px-4 py-3 text-center font-bold text-green-600">
                        ₹ <%= user.balance %>
                    </td>

                    <td class="px-4 py-3 text-center">
                        <%= user.totalTransactions %>
                    </td>

                    <td class="px-4 py-3 text-center">
                        <%= user.totalBets %>
                    </td>

                    <td class="px-4 py-3 text-center text-blue-600 font-semibold">
                        ₹ <%= user.totalBetAmount %>
                    </td>

                    <td class="px-4 py-3 text-center text-green-600 font-semibold">
                        ₹ <%= user.totalWinAmount %>
                    </td>

                    <td class="px-4 py-3 text-center text-red-600 font-semibold">
                        ₹ <%= user.totalLoseAmount %>
                    </td>

                    <td class="px-4 py-3 text-center">

                        <% if(user.status==="active"){ %>

                            <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs">
                                Active
                            </span>

                        <% }else{ %>

                            <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-xs">
                                Blocked
                            </span>

                        <% } %>

                    </td>

                    <td class="px-4 py-3 text-center text-gray-500">
                        <%= new Date(user.createdAt).toLocaleDateString() %>
                    </td>

                </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

    <!-- Pagination -->

    <div class="flex justify-center mt-8 gap-2">

        <% for(let i=1;i<=totalPages;i++){ %>

            <a
                href="/admin/users?page=<%= i %>&search=<%= search %>"
                class="<%= currentPage===i
                    ? 'bg-indigo-600 text-white'
                    : 'bg-gray-200 text-gray-700'
                %> px-4 py-2 rounded-lg"
            >
                <%= i %>
            </a>

        <% } %>

    </div>

</div>