<div class="bg-white rounded-2xl shadow-lg p-6">

    <div class="flex justify-between items-center mb-6">

        <h2 class="text-2xl font-bold">
            Games
        </h2>

        <form
            method="GET"
            action="/admin/games"
            class="flex gap-2"
        >

            <input
                type="text"
                name="search"
                value="<%= search %>"
                placeholder="Search Period"
                class="border rounded-lg px-4 py-2"
            >

            <button
                class="bg-indigo-600 text-white px-5 rounded-lg"
            >
                Search
            </button>

        </form>

    </div>


    <% if(runningGame){ %>

    <div class="mb-6 bg-green-50 border border-green-200 rounded-xl p-5">

        <div class="flex justify-between">

            <div>

                <h3 class="text-lg font-bold text-green-700">

                    Running Game

                </h3>

                <p class="mt-2">

                    Period :

                    <span class="font-semibold">

                        <%= runningGame.period %>

                    </span>

                </p>

            </div>

            <div>

                <span class="bg-green-600 text-white px-4 py-2 rounded-lg">

                    RUNNING

                </span>

            </div>

        </div>

    </div>

    <% } %>


    <div class="overflow-x-auto">

        <table class="min-w-full text-sm">

            <thead class="bg-gray-100">

                <tr>

                    <th class="px-4 py-3 text-left">
                        Period
                    </th>

                    <th class="px-4 py-3 text-center">
                        Number
                    </th>

                    <th class="px-4 py-3 text-center">
                        Color
                    </th>

                    <th class="px-4 py-3 text-center">
                        Size
                    </th>

                    <th class="px-4 py-3 text-center">
                        Players
                    </th>

                    <th class="px-4 py-3 text-center">
                        Bet Amount
                    </th>

                    <th class="px-4 py-3 text-center">
                        Status
                    </th>

                    <th class="px-4 py-3 text-center">
                        Created
                    </th>

                </tr>

            </thead>

            <tbody>

                <% games.forEach(game=>{ %>

                <tr class="border-b hover:bg-gray-50">

                    <td class="px-4 py-3 font-semibold">

                        <%= game.period %>

                    </td>

                    <td class="text-center">

                        <%= game.result?.number ?? "-" %>

                    </td>

                    <td class="text-center">

                        <% if(game.result?.color){ %>

                            <span class="
                                px-3 py-1 rounded-full text-white

                                <%= game.result.color=='green'
                                ?'bg-green-500'
                                :game.result.color=='red'
                                ?'bg-red-500'
                                :'bg-purple-600' %>
                            ">

                                <%= game.result.color %>

                            </span>

                        <% }else{ %>

                            -

                        <% } %>

                    </td>

                    <td class="text-center">

                        <%= game.result?.size ?? "-" %>

                    </td>

                    <td class="text-center">

                        <%= game.totalPlayers %>

                    </td>

                    <td class="text-center font-semibold text-blue-600">

                        ₹ <%= game.totalBetAmount %>

                    </td>

                    <td class="text-center">

                        <% if(game.status==="running"){ %>

                        <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full">

                            Running

                        </span>

                        <% }else if(game.status==="completed"){ %>

                        <span class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full">

                            Completed

                        </span>

                        <% }else{ %>

                        <span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full">

                            Pending

                        </span>

                        <% } %>

                    </td>

                    <td class="text-center text-gray-500">

                        <%= new Date(game.createdAt).toLocaleString() %>

                    </td>

                </tr>

                <% }) %>

            </tbody>

        </table>

    </div>


    <!-- Pagination -->

   <!-- Pagination -->

<% if(totalPages > 1){ %>

<div class="mt-8 flex justify-center items-center gap-2 flex-wrap">

    <!-- Previous -->

    <% if(currentPage > 1){ %>

        <a
            href="/admin/games?page=<%= currentPage - 1 %>&search=<%= search %>"
            class="px-4 py-2 rounded-lg border bg-white hover:bg-indigo-50 hover:border-indigo-500 transition"
        >
            ← Previous
        </a>

    <% }else{ %>

        <span
            class="px-4 py-2 rounded-lg border bg-gray-100 text-gray-400 cursor-not-allowed"
        >
            ← Previous
        </span>

    <% } %>

    <!-- First Page -->

    <% if(currentPage > 3){ %>

        <a
            href="/admin/games?page=1&search=<%= search %>"
            class="px-4 py-2 rounded-lg border bg-white hover:bg-indigo-50"
        >
            1
        </a>

        <% if(currentPage > 4){ %>

            <span class="px-2 text-gray-500">
                ...
            </span>

        <% } %>

    <% } %>

    <!-- Middle Pages -->

    <% 
        const start = Math.max(1, currentPage - 2);
        const end = Math.min(totalPages, currentPage + 2);
    %>

    <% for(let i = start; i <= end; i++){ %>

        <a
            href="/admin/games?page=<%= i %>&search=<%= search %>"
            class="
            px-4
            py-2
            rounded-lg
            border
            transition

            <%= currentPage == i
                ? 'bg-indigo-600 text-white border-indigo-600'
                : 'bg-white hover:bg-indigo-50 hover:border-indigo-500'
            %>
            "
        >
            <%= i %>
        </a>

    <% } %>

    <!-- Last Page -->

    <% if(currentPage < totalPages - 2){ %>

        <% if(currentPage < totalPages - 3){ %>

            <span class="px-2 text-gray-500">
                ...
            </span>

        <% } %>

        <a
            href="/admin/games?page=<%= totalPages %>&search=<%= search %>"
            class="px-4 py-2 rounded-lg border bg-white hover:bg-indigo-50"
        >
            <%= totalPages %>
        </a>

    <% } %>

    <!-- Next -->

    <% if(currentPage < totalPages){ %>

        <a
            href="/admin/games?page=<%= currentPage + 1 %>&search=<%= search %>"
            class="px-4 py-2 rounded-lg border bg-white hover:bg-indigo-50 hover:border-indigo-500 transition"
        >
            Next →
        </a>

    <% }else{ %>

        <span
            class="px-4 py-2 rounded-lg border bg-gray-100 text-gray-400 cursor-not-allowed"
        >
            Next →
        </span>

    <% } %>

</div>

<% } %>

</div>